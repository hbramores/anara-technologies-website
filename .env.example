# ANARA Technologies website frontend — environment variables
#
# Copy this file to `.env` and fill in values as needed.
# Never commit real secrets. Only VITE_ variables are exposed to the browser,
# so never put private keys or credentials in a VITE_ variable.

# Public site URL (used later for canonical URLs and social previews)
VITE_SITE_URL=http://localhost:5173

# Base URL for the forms API. Leave empty to use the same origin (dev proxy).
VITE_API_BASE_URL=

# Google reCAPTCHA v2 site key (public). Leave empty to disable the widget.
VITE_RECAPTCHA_SITE_KEY=

# Google Analytics 4 measurement ID (public). Leave empty to disable analytics.
VITE_GA_MEASUREMENT_ID=

# Absolute URL of a social sharing image (Open Graph / Twitter). Optional.
VITE_OG_IMAGE_URL=
