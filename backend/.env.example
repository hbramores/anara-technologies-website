# Server
PORT=3001

# Comma-separated list of allowed browser origins (production domain here)
ALLOWED_ORIGIN=http://localhost:5173

# Outgoing email (transactional SMTP). Fill these in with ANARA's provider.
# Use an app password / API credential, never a personal password.
MAIL_FROM=
MAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Transport mode: set to "console" only for local development testing.
# Leave unset (or set to "smtp") for real delivery.
MAIL_TRANSPORT=

# Google reCAPTCHA v2 secret key (server-side verification).
# Leave empty to skip CAPTCHA verification during local development.
RECAPTCHA_SECRET=
